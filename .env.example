ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
LOG_LEVEL=INFO
# SPEC-006: the API refuses to start without a key unless RAG_QA_ALLOW_ANONYMOUS=1.
RAG_QA_API_KEY=
RAG_QA_ADMIN_API_KEY=
# SPEC-006 KD-16: the monthly cap is the budget you commit to; the daily ceiling
# is derived from it (monthly / days-in-month) unless you set one explicitly to
# shape the burst — an override is capped at 2x the derived value and warns above
# it. Windows roll over at UTC midnight. Both off when unset. SPEC-010 adds the
# provider-side cap that backs these up — no public URL until both layers live.
RAG_QA_MONTHLY_BUDGET_USD=20.00
RAG_QA_DAILY_BUDGET_USD=
